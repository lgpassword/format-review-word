@page
@model IndexModel
@{
    ViewData["Title"] = "Word 格式检查";
    var report = Model.Session?.Report;
    var severities = report?.Issues.Select(i => i.Severity).Distinct().ToList() ?? [];
    var categories = report?.Issues.Select(i => i.Category).Distinct().ToList() ?? [];
    var isCustomRuleSession = Model.Session?.TemplateFileName == "用户自定义规则";
}

<section class="page-title">
    <h1>Word 格式检查</h1>
    <p>支持按模板检查，也支持先拆分文档模块后由用户填写检查要求。</p>
</section>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<section class="panel">
    <div class="step-heading">
        <span class="step-number">A</span>
        <div>
            <h2>入口一：按模板检查</h2>
            <p>模板支持 .doc 和 .docx，程序会先读取批注和常见格式。</p>
        </div>
    </div>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Template" class="upload-form">
        <input class="form-control" type="file" asp-for="TemplateFile" accept=".doc,.docx" />
        <button class="btn btn-primary" type="submit">分析模板</button>
    </form>
</section>

<section class="panel">
    <div class="step-heading">
        <span class="step-number">B</span>
        <div>
            <h2>入口二：用户自定义模块规则检查</h2>
            <p>先上传需要检查的文档，系统拆分封面、目录、正文标题、正文段落、图题、表题等模块，再由用户填写各模块要求。</p>
        </div>
    </div>
    <form method="post" enctype="multipart/form-data" asp-page-handler="CustomRuleFile" class="upload-form">
        <input class="form-control" type="file" asp-for="CustomRuleFile" accept=".doc,.docx" />
        <button class="btn btn-primary" type="submit">拆分模块并设置规则</button>
    </form>
</section>

@if (Model.Session is not null)
{
    <section class="panel">
        <h2>@(isCustomRuleSession ? "文档模块拆分摘要" : "模板分析摘要")</h2>
        <dl class="summary-grid">
            <div><dt>@(isCustomRuleSession ? "待检查文档" : "模板文件")</dt><dd>@(isCustomRuleSession ? Model.Session.TargetFileName : Model.Session.TemplateFileName)</dd></div>
            <div><dt>批注数量</dt><dd>@Model.Session.TemplateAnalysis.Comments.Count</dd></div>
            <div><dt>段落数量</dt><dd>@Model.Session.TemplateAnalysis.Paragraphs.Count</dd></div>
            <div><dt>表格数量</dt><dd>@Model.Session.TemplateAnalysis.Tables.Count</dd></div>
            <div><dt>常见中文字体</dt><dd>@(Model.Session.TemplateAnalysis.Baseline.CommonChineseFontName.Length == 0 ? "未识别" : Model.Session.TemplateAnalysis.Baseline.CommonChineseFontName)</dd></div>
            <div><dt>常见西文字体</dt><dd>@(Model.Session.TemplateAnalysis.Baseline.CommonWesternFontName.Length == 0 ? "未识别" : Model.Session.TemplateAnalysis.Baseline.CommonWesternFontName)</dd></div>
            <div><dt>常见字号</dt><dd>@(Model.Session.TemplateAnalysis.Baseline.CommonFontSize.Length == 0 ? "未识别" : Model.Session.TemplateAnalysis.Baseline.CommonFontSize)</dd></div>
        </dl>

        @if (!isCustomRuleSession)
        {
            <form method="post" enctype="multipart/form-data" asp-page-handler="ReferenceTemplate" class="upload-form">
                <input type="hidden" asp-for="SessionId" value="@Model.Session.Id" />
                <input class="form-control" type="file" asp-for="ReferenceTemplateFile" accept=".doc,.docx" />
                <button class="btn btn-outline-primary" type="submit">上传合格参考模板</button>
            </form>

            @if (Model.Session.ReferenceTemplates.Count > 0)
            {
                <details open>
                    <summary>已上传合格参考模板：@Model.Session.ReferenceTemplates.Count 个</summary>
                    <ul class="comment-list">
                        @foreach (var reference in Model.Session.ReferenceTemplates)
                        {
                            <li>@reference.FileName</li>
                        }
                    </ul>
                </details>
            }
        }

        @if (!isCustomRuleSession && Model.Session.RuleConflicts.Count > 0)
        {
            <section class="panel">
                <h3>模板规则冲突</h3>
                <p>总模板和合格参考模板存在差异，请选择本次检查采用的规则。</p>
                <form method="post" asp-page-handler="ResolveConflicts">
                    <input type="hidden" asp-for="SessionId" value="@Model.Session.Id" />
                    <div class="table-responsive">
                        <table class="table table-sm issue-table rule-table">
                            <thead>
                            <tr>
                                <th>规则</th>
                                <th>总模板</th>
                                <th>合格参考模板差异</th>
                                <th>本次采用</th>
                                <th>自定义规则</th>
                                <th>状态</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var conflict in Model.Session.RuleConflicts)
                            {
                                <tr>
                                    <td>@conflict.Category / @conflict.RuleName</td>
                                    <td>@conflict.PrimaryValue</td>
                                    <td>
                                        @if (conflict.ReferenceOptions.Count > 0)
                                        {
                                            <ul class="conflict-options">
                                                @foreach (var option in conflict.ReferenceOptions)
                                                {
                                                    <li>@option.Source：@option.DisplayValue</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            @conflict.ReferenceValue
                                        }
                                    </td>
                                    <td>
                                        <select class="form-select" name="ConflictSelections[@conflict.ConflictId]">
                                            @if (conflict.Source == "总模板")
                                            {
                                                <option value="primary" selected>采用总模板</option>
                                            }
                                            else
                                            {
                                                <option value="primary">采用总模板</option>
                                            }
                                            @foreach (var option in conflict.ReferenceOptions)
                                            {
                                                if (conflict.Source == option.Source)
                                                {
                                                    <option value="@option.Source" selected>采用 @option.Source</option>
                                                }
                                                else
                                                {
                                                    <option value="@option.Source">采用 @option.Source</option>
                                                }
                                            }
                                            @if (conflict.Source == "本次自定义")
                                            {
                                                <option value="custom" selected>使用自定义</option>
                                            }
                                            else
                                            {
                                                <option value="custom">使用自定义</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input class="form-control conflict-custom" name="ConflictCustomValues[@conflict.ConflictId]" value="@(conflict.Source == "本次自定义" ? conflict.SelectedValue : "")" placeholder="如：小四、楷体、居中对齐" />
                                    </td>
                                    <td>@(conflict.IsResolved ? $"已选择：{conflict.Source}（{conflict.SelectedValue}）" : "待确认")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-warning" type="submit">保存本次规则选择</button>
                </form>
            </section>
        }

        @if (Model.Session.EffectiveRules.Count > 0)
        {
            <details open>
                <summary>@(isCustomRuleSession ? "按模块填写检查要求" : "查看和编辑本次采用的格式规则")：@Model.Session.EffectiveRules.Count 条</summary>
                <form method="post" asp-page-handler="@(isCustomRuleSession ? "RunCustomRules" : "SaveRules")">
                    <input type="hidden" asp-for="SessionId" value="@Model.Session.Id" />
                    <div class="table-responsive">
                        <table class="table table-sm issue-table rule-table">
                            <thead>
                            <tr>
                                <th>区域/块</th>
                                <th>覆盖内容</th>
                                <th>中文字体</th>
                                <th>西文字体</th>
                                <th>字号</th>
                                <th>对齐</th>
                                <th>段前</th>
                                <th>段后</th>
                                <th>行距</th>
                                <th>首行缩进</th>
                                <th>来源</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var rule in Model.Session.EffectiveRules)
                            {
                                <tr>
                                    <td>
                                        <strong>@rule.Area</strong><br />
                                        <span class="muted">@rule.BlockType</span>
                                    </td>
                                    <td>
                                        <strong>@rule.ParagraphCount 段</strong><br />
                                        <span class="muted">@rule.SampleText</span>
                                    </td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].ChineseFontName" value="@rule.ChineseFontName" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].WesternFontName" value="@rule.WesternFontName" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].FontSize" value="@rule.FontSize" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].Justification" value="@rule.Justification" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].SpacingBefore" value="@rule.SpacingBefore" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].SpacingAfter" value="@rule.SpacingAfter" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].LineSpacing" value="@rule.LineSpacing" /></td>
                                    <td><input class="form-control form-control-sm" name="RuleEdits[@rule.RuleId].FirstLineIndent" value="@rule.FirstLineIndent" /></td>
                                    <td>@rule.Source</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-warning" type="submit">@(isCustomRuleSession ? "按填写规则开始检查" : "保存本次规则")</button>
                </form>
            </details>
        }

        @if (Model.Session.TemplateAnalysis.Comments.Count > 0)
        {
            <details>
                <summary>查看模板批注</summary>
                <ul class="comment-list">
                    @foreach (var comment in Model.Session.TemplateAnalysis.Comments.Take(20))
                    {
                        <li><strong>@comment.Author</strong>：@comment.Text</li>
                    }
                </ul>
            </details>
        }
    </section>

    @if (!isCustomRuleSession)
    {
        <section class="panel">
        <div class="step-heading">
            <span class="step-number">2</span>
            <div>
                <h2>上传实际文档</h2>
                <p>只有模板分析完成后，才进行实际文档检查。</p>
            </div>
        </div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Target" class="upload-form">
            <input type="hidden" asp-for="SessionId" value="@Model.Session.Id" />
            <input class="form-control" type="file" asp-for="TargetFile" accept=".doc,.docx" />
            <button class="btn btn-success" type="submit">开始检测</button>
        </form>
        </section>
    }
}

@if (report is not null)
{
    <section class="panel">
        <h2>检测报告</h2>
        <dl class="summary-grid">
            <div><dt>报告编号</dt><dd>@report.ReportId</dd></div>
            <div><dt>实际文档</dt><dd>@report.TargetFileName</dd></div>
            <div><dt>检测结论</dt><dd>@report.Conclusion</dd></div>
            <div><dt>问题总数</dt><dd>@report.Issues.Count</dd></div>
        </dl>

        <div class="summary-columns">
            <section>
                <h3>按区域统计</h3>
                <ul class="comment-list">
                    @foreach (var item in report.AreaSummaries)
                    {
                        <li>@item.Name：@item.Count</li>
                    }
                </ul>
            </section>
            <section>
                <h3>按问题类型统计</h3>
                <ul class="comment-list">
                    @foreach (var item in report.CategorySummaries)
                    {
                        <li>@item.Name：@item.Count</li>
                    }
                </ul>
            </section>
            <section>
                <h3>按严重程度统计</h3>
                <ul class="comment-list">
                    @foreach (var item in report.SeveritySummaries)
                    {
                        <li>@item.Name：@item.Count</li>
                    }
                </ul>
            </section>
        </div>

        @if (report.CoverageAreas.Count > 0)
        {
            <h3>检查覆盖率</h3>
            <div class="table-responsive">
                <table class="table table-sm issue-table">
                    <thead>
                    <tr>
                        <th>区域</th>
                        <th>覆盖率</th>
                        <th>字符</th>
                        <th>段落</th>
                        <th>对象</th>
                        <th>说明</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var area in report.CoverageAreas)
                    {
                        <tr class="@(area.CoveragePercent < 90 ? "table-warning" : "")">
                            <td>@area.Area</td>
                            <td>@area.CoveragePercent%</td>
                            <td>@area.CheckedCharacterCount / @area.CharacterCount</td>
                            <td>@area.CheckedParagraphCount / @area.ParagraphCount</td>
                            <td>@area.CheckedObjectCount / @area.ObjectCount</td>
                            <td>@string.Join("；", area.Notes)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (report.UncheckedItems.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>存在未完整检查项：</strong>
                @foreach (var item in report.UncheckedItems)
                {
                    <div>@item.Area：@item.Reason</div>
                }
            </div>
        }

        <div class="actions">
            <a class="btn btn-outline-primary" asp-page-handler="Download" asp-route-sessionId="@Model.Session!.Id" asp-route-kind="word">下载带批注 Word</a>
            <a class="btn btn-outline-success" asp-page-handler="Download" asp-route-sessionId="@Model.Session!.Id" asp-route-kind="normal">下载正常文档</a>
            <a class="btn btn-outline-secondary" asp-page-handler="Download" asp-route-sessionId="@Model.Session!.Id" asp-route-kind="html">导出 HTML 报告</a>
        </div>

        <form method="get" class="filter-form">
            <input type="hidden" name="sessionId" value="@Model.Session!.Id" />
            <select class="form-select" name="severity">
                <option value="">全部级别</option>
                @foreach (var severity in severities)
                {
                    if (Model.Severity == severity)
                    {
                        <option value="@severity" selected>@severity</option>
                    }
                    else
                    {
                        <option value="@severity">@severity</option>
                    }
                }
            </select>
            <select class="form-select" name="category">
                <option value="">全部类型</option>
                @foreach (var category in categories)
                {
                    if (Model.Category == category)
                    {
                        <option value="@category" selected>@category</option>
                    }
                    else
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>
            <button class="btn btn-light" type="submit">筛选</button>
        </form>

        <div class="table-responsive">
            <table class="table table-sm issue-table">
                <thead>
                <tr>
                    <th>编号</th>
                    <th>级别</th>
                    <th>类型</th>
                    <th>位置</th>
                    <th>问题</th>
                    <th>模板要求</th>
                    <th>实际情况</th>
                    <th>修改建议</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var issue in Model.VisibleIssues)
                {
                    <tr>
                        <td>@issue.IssueCode</td>
                        <td><span class="severity">@issue.Severity</span></td>
                        <td>@issue.Category</td>
                        <td>@issue.Location</td>
                        <td>@Model.IssueTitle(issue)</td>
                        <td>@Model.IssueExpected(issue)</td>
                        <td>@Model.IssueActual(issue)</td>
                        <td>@issue.Suggestion</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
